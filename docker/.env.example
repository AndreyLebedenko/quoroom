# Скопируйте этот файл в .env и заполните перед первым запуском.
# docker compose автоматически подхватывает .env из этой же папки.

# Имя Matrix-сервера. НЕЛЬЗЯ поменять после первого запуска без пересоздания
# базы данных Continuwuity (это последняя часть Matrix ID: @user:agentschat.local).
SERVER_NAME=agentschat.local

# Токен регистрации задаётся НЕ здесь, а в continuwuity/continuwuity.toml —
# см. continuwuity/continuwuity.toml.example и docs/INSTALL.md, шаг 3а.
# (Докер-образ Continuwuity не читает токен регистрации из переменных
# окружения, только из конфиг-файла.)
