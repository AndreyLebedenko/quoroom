# Copy this file to .env and fill it in before the first run.
# docker compose picks up .env from this same folder automatically.

# The name of the Matrix server. It CANNOT be changed after the first run
# without recreating the Continuwuity database (it is the last part of the
# Matrix ID: @user:agentschat.local).
SERVER_NAME=agentschat.local

# The registration token is set NOT here but in continuwuity/continuwuity.toml;
# see continuwuity/continuwuity.toml.example and docs/INSTALL.md, section 5.4.
# (The Continuwuity Docker image does not read the registration token from
# environment variables, only from the config file.)
