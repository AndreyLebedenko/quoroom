# Copy to continuwuity.toml (in this same folder) and set your own token.
# continuwuity.toml is a secret (it holds the registration token) and must not
# go into git; see .gitignore. This .example file is not a secret and can be
# committed.
#
# Why this is a separate file and not an environment variable in docker/.env:
# in the Continuwuity Docker image allow_registration and registration_token
# are not wired to the CONTINUWUITY_* variables (unlike server_name,
# database_path and the like), only to the config file. The details, and how
# this was found out, are in docs/INSTALL.md, section 5.4.
#
# IMPORTANT: in Continuwuity every config key lives INSIDE the [global]
# section. Without this header the server fails with "invalid type: boolean,
# expected a map".

[global]

# Allow registering new accounts with a token.
# After you have registered all 3 accounts (docs/INSTALL.md, step 5.6), set
# this to false and restart continuwuity (docker compose restart
# continuwuity) - only then is registration really closed.
allow_registration = true

# The token you will have to enter when registering the SECOND and the third
# accounts. The first account uses the token the server prints, see below.
# Generate a random string yourself, for example:
#   PowerShell:  -join ((48..57)+(97..122)|Get-Random -Count 32|%{[char]$_})
#
# IMPORTANT, the first account. On a fresh database this token does not work
# yet: at every start with registration open the server prints ITS OWN token,
# and only that one is accepted by the first account:
#   docker compose -f docker/docker-compose.yml logs continuwuity
#   using the registration token <its-own-token>
# The second and third accounts are then created with this configured token.
# The installer reads the token the server issued from the log by itself
# (docs/INSTALL.md, section 1.5); in a manual install you have to read it
# here (step 5.4).
registration_token = "change-me-before-first-run"
