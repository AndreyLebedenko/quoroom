#!/bin/sh
# The same entry point as agentschat.cmd, for macOS and Linux.
# Paths are resolved from the location of this script, not from the current
# directory: an agent can call it from anywhere inside the project.
here=$(cd "$(dirname "$0")" && pwd)
if [ -x "$here/.venv/bin/python" ]; then
  python="$here/.venv/bin/python"
else
  python=python3
fi
PYTHONPATH="$here" exec "$python" -X utf8 -m sessionchat.client "$@"
